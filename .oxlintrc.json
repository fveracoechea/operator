{
  "jsPlugins": [{ "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/index.ts" }],
  "rules": {
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-widen-then-assert": "error",
    "oxc/no-accumulating-spread": "error",
    "complexity": ["error", { "max": 15 }]
  },
  "overrides": [
    {
      "files": [
        "modules/crew-state/acceptance.ts",
        "modules/crew-state/frontier.ts",
        "modules/crew-state/integration.ts",
        "modules/crew-state/invalidate.ts",
        "modules/crew-state/next.ts",
        "modules/crew-state/publish.ts",
        "modules/crew-state/registration.ts",
        "modules/crew-state/review-report.ts",
        "modules/crew-state/tracker-apply.ts",
        "modules/crew-state/tracker-show.ts",
        "modules/live-probe/main.ts",
        "modules/live-probe/recovery.ts",
        "modules/live-probe/tracker.ts",
        "modules/operator-cli/arguments.ts",
        "modules/operator-cli/attempt-command.ts",
        "modules/operator-cli/outside-command.ts",
        "modules/operator-cli/publish-command.ts",
        "modules/operator-cli/rebase-command.ts",
        "modules/operator-cli/review-command.ts",
        "modules/operator-cli/run.ts",
        "modules/operator-cli/setup-command.ts",
        "modules/operator-cli/tracker-command.ts",
        "modules/operator-cli/wake-command.ts",
        "modules/release-install/inspect.ts",
        "modules/release-install/worktree.ts"
      ],
      "rules": { "complexity": ["error", { "max": 30 }] }
    }
  ]
}
