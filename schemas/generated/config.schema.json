{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "const": "./config.schema.json"
    },
    "operator": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "enum": [
            "opencode",
            "claude"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "crew": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "enum": [
            "opencode",
            "claude"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "$schema"
  ],
  "additionalProperties": false
}
